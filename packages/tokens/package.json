{
  "name": "@zui/tokens",
  "version": "0.3.0",
  "description": "ZUI 设计令牌：三层 CSS 变量 + TS 常量 + DTCG JSON",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": "./src/index.css",
    "./css/base": "./src/base.css",
    "./css/semantic": "./src/semantic.css",
    "./css/dark": "./src/dark.css",
    "./tokens.json": "./src/tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
