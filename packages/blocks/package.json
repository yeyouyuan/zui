{
  "name": "@zui/blocks",
  "version": "0.2.0",
  "description": "ZUI 业务区块：16 个覆盖数据展示、表单账户与系统管理的 React 页面级区块",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./login": {
      "types": "./dist/login/index.d.ts",
      "import": "./dist/login/index.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard/index.d.ts",
      "import": "./dist/dashboard/index.js"
    },
    "./table-page": {
      "types": "./dist/table-page/index.d.ts",
      "import": "./dist/table-page/index.js"
    },
    "./form-page": {
      "types": "./dist/form-page/index.d.ts",
      "import": "./dist/form-page/index.js"
    },
    "./package.json": "./package.json",
    "./user-center": {
      "types": "./dist/user-center/index.d.ts",
      "import": "./dist/user-center/index.js"
    },
    "./permission": {
      "types": "./dist/permission/index.d.ts",
      "import": "./dist/permission/index.js"
    },
    "./settings": {
      "types": "./dist/settings/index.d.ts",
      "import": "./dist/settings/index.js"
    },
    "./wizard": {
      "types": "./dist/wizard/index.d.ts",
      "import": "./dist/wizard/index.js"
    },
    "./profile-edit": {
      "types": "./dist/profile-edit/index.d.ts",
      "import": "./dist/profile-edit/index.js"
    },
    "./order-list": {
      "types": "./dist/order-list/index.d.ts",
      "import": "./dist/order-list/index.js"
    },
    "./data-screen": {
      "types": "./dist/data-screen/index.d.ts",
      "import": "./dist/data-screen/index.js"
    },
    "./timeline-feed": {
      "types": "./dist/timeline-feed/index.d.ts",
      "import": "./dist/timeline-feed/index.js"
    },
    "./kanban": {
      "types": "./dist/kanban/index.d.ts",
      "import": "./dist/kanban/index.js"
    },
    "./error-pages": {
      "types": "./dist/error-pages/index.d.ts",
      "import": "./dist/error-pages/index.js"
    },
    "./search-result": {
      "types": "./dist/search-result/index.d.ts",
      "import": "./dist/search-result/index.js"
    },
    "./list-detail": {
      "types": "./dist/list-detail/index.d.ts",
      "import": "./dist/list-detail/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@zui/react": "workspace:*"
  }
}
