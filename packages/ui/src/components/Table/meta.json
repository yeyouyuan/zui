{
  "name": "Table",
  "description": "表格：语义化组合用法与专业数据模式；数据模式支持显式排序菜单、专用手柄列移动、受控排序、字段搜索/显隐/重排",
  "category": "数据展示",
  "useCase": [
    "配置/记录类数据列表",
    "需要明确排序状态与可配置字段的数据表",
    "客户端或服务端排序的中小数据量"
  ],
  "dontUse": ["上万行大数据用 VirtualTable（虚拟滚动）", "层级数据用 Tree", "卡片流式布局用 List"],
  "props": {
    "density": {
      "type": "'comfortable' | 'compact'",
      "default": "'comfortable'",
      "desc": "行高密度（根 data-density）"
    },
    "bordered": { "type": "boolean", "default": "false", "desc": "外框与单元格分隔线" },
    "striped": { "type": "boolean", "default": "false", "desc": "斑马纹" },
    "data": { "type": "T[]", "desc": "数据模式的行数组；与 columns 同时传入时启用" },
    "columns": {
      "type": "TableColumn<T>[]",
      "desc": "字段配置：key/title/width/align/sortable/sorter/render；render 第三参数为 sourceIndex"
    },
    "rowKey": {
      "type": "keyof T | ((row, index) => Key)",
      "desc": "行 key 字段名或取值函数"
    },
    "columnState": {
      "type": "{ order?: string[]; hidden?: string[] }",
      "desc": "受控字段状态：显示顺序与隐藏字段；未知/重复 key 会归一化"
    },
    "defaultColumnState": {
      "type": "TableColumnState",
      "desc": "非受控初始字段状态"
    },
    "onColumnStateChange": {
      "type": "(state: TableColumnState) => void",
      "desc": "字段拖拽、键盘移动、上下移、显隐或恢复默认时回调"
    },
    "sortState": {
      "type": "TableSortState | null",
      "desc": "受控单字段排序状态"
    },
    "defaultSortState": {
      "type": "TableSortState | null",
      "default": "null",
      "desc": "非受控初始排序状态"
    },
    "onSortStateChange": {
      "type": "(state: TableSortState | null) => void",
      "desc": "升序、降序或清除排序回调"
    },
    "sortMode": {
      "type": "'client' | 'manual'",
      "default": "'client'",
      "desc": "client 本地重排行；manual 只回调状态，供服务端排序"
    },
    "Table.Row.selected": {
      "type": "boolean",
      "default": "false",
      "desc": "行选中态（data-selected）"
    },
    "Table.HeaderCell.align": {
      "type": "'left' | 'center' | 'right'",
      "default": "'left'",
      "desc": "语义模式表头对齐"
    },
    "Table.Cell.align": {
      "type": "'left' | 'center' | 'right'",
      "default": "'left'",
      "desc": "语义模式单元格对齐"
    },
    "classNames": { "type": "{ root? }", "default": "—", "desc": "table 根元素类名追加" }
  },
  "a11yNotes": [
    "语义结构保持 table/thead/tbody/tr/th[scope=col]/td",
    "排序由字段名触发器循环升序/降序/清除；只有当前活动 th 带 aria-sort=ascending/descending，摘要标签提供显式清除",
    "字段移动只由具名手柄启动；Alt+方向/Home/End 与面板上下移按钮提供非拖拽替代",
    "字段管理为具名 dialog，支持搜索、全选 indeterminate、最后一列 disabled 说明与恢复默认",
    "排序、移动和显隐结果通过 polite live region 播报",
    "数据模式表格位于具名、可聚焦的局部横向滚动区"
  ],
  "related": ["Pagination", "VirtualTable", "Checkbox", "Popover", "DropdownMenu", "Tooltip"]
}
