{
  "name": "zui",
  "private": true,
  "version": "0.1.0",
  "description": "ZUI — 现代 React 组件库：令牌驱动、零运行时样式、无障碍优先",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @zui/docs dev",
    "office:start": "node scripts/office-runtime.mjs start",
    "office:status": "node scripts/office-runtime.mjs status",
    "office:stop": "node scripts/office-runtime.mjs stop",
    "lint": "eslint .",
    "format": "prettier --write .",
    "changeset": "changeset",
    "release": "node scripts/publish-github-packages.mjs",
    "release:prepare": "node scripts/prepare-github-packages.mjs --owner yeyouyuan",
    "release:check": "node scripts/check-github-packages.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.65.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  },
  "packageManager": "pnpm@10.28.1",
  "type": "module"
}
